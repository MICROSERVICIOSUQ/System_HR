{
  "name": "vacations-service",
  "version": "1.0.0",
  "description": "Microservicio de Vacaciones - Consumidor de eventos RabbitMQ para System_HR",
  "main": "src/server.ts",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "pretest": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\"",
    "test": "tsx --import ./src/tests/entorno-pruebas.ts --test --experimental-test-coverage --test-coverage-include=\"src/domain/**\" --test-coverage-include=\"src/services/**\" --test-coverage-exclude=\"src/tests/**\" --test-coverage-exclude=\"src/generated/**\" --test-coverage-exclude=\"src/repositories/**\" --test-coverage-exclude=\"src/messaging/**\" --test-coverage-lines=70 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info src/tests/*.test.ts",
    "test:ci": "tsx --import ./src/tests/entorno-pruebas.ts --test --experimental-test-coverage --test-coverage-include=\"src/domain/**\" --test-coverage-include=\"src/services/**\" --test-coverage-exclude=\"src/tests/**\" --test-coverage-exclude=\"src/generated/**\" --test-coverage-exclude=\"src/repositories/**\" --test-coverage-exclude=\"src/messaging/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml --test-reporter=lcov --test-reporter-destination=reports/lcov.info src/tests/*.test.ts",
    "pretest:ci": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\"",
    "test:integration": "prisma migrate deploy && tsx --test --test-concurrency=1 src/tests/*.integration.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-zipkin": "^3.1.0",
    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqplib": "^0.10.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.20.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
