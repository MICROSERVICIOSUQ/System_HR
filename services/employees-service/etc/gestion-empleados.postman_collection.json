        {
          "name": "3.4 Estado fuera del enum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Mensaje de cuerpo ilegible', () => {",
                  "    pm.expect(pm.response.json().message).to.include('no es un JSON válido');",
                  "});"
                ]
              }
