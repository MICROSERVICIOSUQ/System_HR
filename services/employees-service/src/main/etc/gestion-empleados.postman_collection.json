              "raw": "{\n  \"nombre\": \"Pedro\",\n  \"apellido\": \"López\",\n  \"email\": \"ana.garcia@empresa.com\",\n  \"numeroEmpleado\": \"EMP-999\",\n  \"cargo\": \"Analista\",\n  \"area\": \"Ventas\",\n  \"departamentoId\": \"DEPT-VT\",\n  \"fechaIngreso\": \"2024-04-01\"\n}",
