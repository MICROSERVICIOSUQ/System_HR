pipeline {
    agent { label 'docker' }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Rama que se construirá')
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SONAR_PROJECT_KEY = 'employees-service'
        SONAR_QUALITY_GATE = 'RRHH-70'
        IMAGE = "system-hr/employees-service:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: params.BRANCH, url: env.GIT_URL
            }
        }

        stage('Build') {
            steps {
                dir('services/employees-service') {
                    sh 'mvn -B clean compile -DskipTests'
                }
            }
        }

        stage('Test+JaCoCo') {
            steps {
                dir('services/employees-service') {
                    sh '''
                        mvn -B \
                          org.jacoco:jacoco-maven-plugin:prepare-agent \
                          verify \
                          org.jacoco:jacoco-maven-plugin:report
                    '''
                }
            }
            post {
                always {
                    junit testResults: 'services/employees-service/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: false
                    archiveArtifacts artifacts: 'services/employees-service/target/site/jacoco/**',
                        allowEmptyArchive: false
                }
            }
        }

        stage('Sonar Scan') {
            steps {
                dir('services/employees-service') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn -B sonar:sonar -Dsonar.projectKey=$SONAR_PROJECT_KEY -Dsonar.qualitygate.wait=false'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo "Validando Quality Gate ${env.SONAR_QUALITY_GATE}"
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker build') {
            steps {
                sh 'docker build --tag "$IMAGE" services/employees-service'
            }
        }
    }
}
