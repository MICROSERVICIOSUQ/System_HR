pipeline {
    agent { label 'docker' }

    parameters {
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Rama que se construirá'
        )
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SONAR_PROJECT_KEY = 'notifications-service'
        SONAR_QUALITY_GATE = 'RRHH-70'
        IMAGE = "system-hr/notifications-service:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Las etapas siguientes ejecutan contenedores que escriben en el
                // workspace como root (coverage.xml, .pytest_cache, target/,
                // node_modules, coverage.out). Jenkins corre como el usuario
                // 'jenkins', de modo que el deleteDir() de la ejecucion
                // siguiente fallaba con AccessDeniedException: el primer build
                // de cada trabajo pasaba y el segundo ni arrancaba. Se vacia
                // antes con un contenedor root, usando el mismo mecanismo de
                // montaje que ya usan las demas etapas.
                script {
                    docker.image('alpine:3.22').inside('-u root') {
                        sh 'rm -rf ./* ./.[!.]* 2>/dev/null || true'
                    }
                }
                deleteDir()
                git branch: params.BRANCH, url: env.GIT_URL
            }
        }

        stage('go test ./... -coverprofile=coverage.out') {
            steps {
                script {
                    docker.image('golang:1.25-alpine').inside(
                        // -u root: el volumen hr-ci-go pertenece a root y el
                        // contenedor corria como uid 1000, asi que 'go mod
                        // download' fallaba con "mkdir /go/pkg/mod/cache:
                        // permission denied" en cada dependencia. Es el mismo
                        // motivo por el que los pipelines de Node usan -u root
                        // con hr-ci-npm.
                        '-u root -v hr-ci-go:/go/pkg/mod'
                    ) {
                        dir('services/notifications-service') {
                            sh '''
                                go mod download
                                go test ./... -coverprofile=coverage.out

                                coverage=$(go tool cover -func=coverage.out \
                                    | awk '/^total:/ {gsub(/%/, "", $3); print $3}')
                                awk -v coverage="$coverage" \
                                    'BEGIN {
                                        if (coverage < 70) {
                                            printf "Cobertura %.2f%% inferior al 70%%\\n", coverage
                                            exit 1
                                        }
                                    }'
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts:
                        'services/notifications-service/coverage.out',
                        allowEmptyArchive: false
                }
            }
        }

        stage('Sonar Scan') {
            steps {
                script {
                    withSonarQubeEnv('SonarQube') {
                        docker.image('sonarsource/sonar-scanner-cli:11').inside(
                            "-u root --network ${env.CI_NETWORK ?: 'system_hr_ci'}"
                        ) {
                            dir('services/notifications-service') {
                                sh 'sonar-scanner -Dsonar.projectKey=$SONAR_PROJECT_KEY'
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo "Validando Quality Gate ${env.SONAR_QUALITY_GATE}"
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker build') {
            steps {
                sh 'docker build --tag "$IMAGE" services/notifications-service'
            }
        }
    }
}
