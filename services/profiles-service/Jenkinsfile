pipeline {
    agent { label 'docker' }

    parameters {
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Rama que se construirá'
        )
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SONAR_PROJECT_KEY = 'profiles-service'
        SONAR_QUALITY_GATE = 'RRHH-70'
        IMAGE = "system-hr/profiles-service:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Las etapas siguientes ejecutan contenedores que escriben en el
                // workspace como root (coverage.xml, .pytest_cache, target/,
                // node_modules, coverage.out). Jenkins corre como el usuario
                // 'jenkins', de modo que el deleteDir() de la ejecucion
                // siguiente fallaba con AccessDeniedException: el primer build
                // de cada trabajo pasaba y el segundo ni arrancaba. Se vacia
                // antes con un contenedor root, usando el mismo mecanismo de
                // montaje que ya usan las demas etapas.
                script {
                    docker.image('alpine:3.22').inside('-u root') {
                        sh 'rm -rf ./* ./.[!.]* 2>/dev/null || true'
                    }
                }
                deleteDir()
                git branch: params.BRANCH, url: env.GIT_URL
            }
        }

        stage('npm ci') {
            steps {
                script {
                    docker.image('node:22-bookworm-slim').inside(
                        '-u root -v hr-ci-npm:/root/.npm'
                    ) {
                        dir('services/profiles-service') {
                            sh 'npm ci'
                        }
                    }
                }
            }
        }

        stage('npm test (LCOV + umbral 70%)') {
            steps {
                script {
                    docker.image('node:22-bookworm-slim').inside(
                        '-u root -v hr-ci-npm:/root/.npm'
                    ) {
                        dir('services/profiles-service') {
                            // 'npm test' y no 'npm test -- --coverage': los
                            // indicadores de cobertura viven en el script del
                            // package.json, con el umbral del 70 % que corta la
                            // ejecucion. Pasar --coverage por detras lo anadia
                            // como argumento suelto del runner de pruebas y no
                            // generaba ningun informe, asi que esta etapa
                            // fallaba en el 'test -f' de la linea siguiente.
                            sh '''
                                npm test
                                test -f coverage/lcov.info
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts:
                        'services/profiles-service/coverage/lcov.info',
                        allowEmptyArchive: false
                }
            }
        }

        stage('Sonar Scan') {
            steps {
                script {
                    withSonarQubeEnv('SonarQube') {
                        docker.image('sonarsource/sonar-scanner-cli:11').inside(
                            "-u root --network ${env.CI_NETWORK ?: 'system_hr_ci'}"
                        ) {
                            dir('services/profiles-service') {
                                sh 'sonar-scanner -Dsonar.projectKey=$SONAR_PROJECT_KEY'
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo "Validando Quality Gate ${env.SONAR_QUALITY_GATE}"
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker build') {
            steps {
                sh 'docker build --tag "$IMAGE" services/profiles-service'
            }
        }
    }
}
