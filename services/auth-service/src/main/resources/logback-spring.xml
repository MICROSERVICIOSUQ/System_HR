<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs estructurados en JSON (Reto 8).

  Mismo formato en los tres servicios Java y en los cuatro de Node, para que una
  consulta LogQL en Grafana sirva para todo el ecosistema sin casos especiales.

  El campo traceId lo pone Micrometer Tracing en el MDC; aquí solo se vuelca al
  JSON. En el gateway tiene un valor añadido: como el traceId nace aquí, su log
  es el punto de partida para seguir una petición por todo el sistema.
-->
<configuration>

    <springProperty scope="context" name="nombreServicio"
                    source="spring.application.name" defaultValue="auth-service"/>

    <appender name="CONSOLA_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <pattern>
                    <pattern>
                        {
                        "service": "${nombreServicio}",
                        "traceId": "%mdc{traceId:-}",
                        "spanId": "%mdc{spanId:-}"
                        }
                    </pattern>
                </pattern>
                <loggerName>
                    <fieldName>logger</fieldName>
                    <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <arguments/>
                <stackTrace>
                    <fieldName>stackTrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <appender name="CONSOLA_LEGIBLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="CONSOLA_JSON"/>
        </root>
    </springProfile>

    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLA_LEGIBLE"/>
        </root>
    </springProfile>

</configuration>
