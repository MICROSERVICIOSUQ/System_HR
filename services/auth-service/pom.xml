<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.microservicios</groupId>
    <artifactId>auth-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>auth-service</name>
    <description>Identity provider: credential verification, JWT issuance and account lifecycle</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Misma versión que en api-gateway y employees-service: la 7.4 vale
             para el Logback de Spring Boot 3.2 y para el de 3.4. -->
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Solo el módulo de criptografía de Spring Security: aporta BCryptPasswordEncoder
             sin activar la cadena de filtros web. La validación del JWT en las peticiones
             entrantes es responsabilidad del api-gateway (ver ADR-008). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.5</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ── Observabilidad (Reto 8) ──────────────────────────────────── -->

        <!-- Métricas en formato Prometheus (/actuator/prometheus). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Trazas sobre el SDK de OpenTelemetry, con propagación W3C. En este
             servicio importa especialmente la mitad asíncrona: consume
             empleado.creado y vacaciones.iniciadas, y para que esos spans
             cuelguen de la traza que los originó hay que extraer el contexto de
             las cabeceras del mensaje (ver HrEventListener). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-zipkin</artifactId>
        </dependency>

        <!-- Logs JSON con traceId. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Surefire arma el classpath del JVM de tests en un JAR de manifiesto;
                    con rutas que contienen caracteres no ASCII (tildes, eñes) en Windows
                    ese manifiesto se corrompe y los tests fallan con NoClassDefFoundError.
                    Pasar el classpath directamente evita el problema. -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                    <!-- @{argLine} y no solo el flag: prepare-agent de JaCoCo publica
                    el -javaagent en la propiedad argLine, y una configuracion
                    explicita como esta la sustituia. El agente no se enganchaba, no
                    se escribia jacoco.exec y el informe se omitia con "missing
                    execution data file": SonarQube se quedaba sin cobertura. El
                    @{...} es sustitucion tardia, asi que convive con el flag. -->
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <!-- Cobertura para el analisis de SonarQube.
                 Antes el pipeline lo invocaba desde la linea de comandos
                 (mvn org.jacoco:jacoco-maven-plugin:prepare-agent verify
                  org.jacoco:jacoco-maven-plugin:report) y el agente no llegaba a
                 engancharse a surefire: el informe se omitia con "Skipping JaCoCo
                 execution due to missing execution data file" y la etapa fallaba
                 al archivar un directorio que no existia. Declarado aqui, las
                 ejecuciones quedan ligadas al ciclo de vida y basta 'mvn verify'.
                 El umbral del 70 % no se aplica localmente: lo exige el Quality
                 Gate RRHH-70 de SonarQube, que es donde la auditoria lo pide. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
