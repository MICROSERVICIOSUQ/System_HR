{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-hr/schemas/empleado.schema.json",
  "title": "EmpleadoData",
  "description": "Estructura del campo `data` para eventos del dominio empleado.",
  "type": "object",
  "required": ["id", "nombre", "apellido", "email", "departamentoId", "fechaIngreso"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único del empleado."
    },
    "nombre": {
      "type": "string",
      "description": "Nombre(s) del empleado."
    },
    "apellido": {
      "type": "string",
      "description": "Apellido(s) del empleado."
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electrónico corporativo."
    },
    "departamentoId": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador del departamento al que pertenece."
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o título del puesto."
    },
    "fechaIngreso": {
      "type": "string",
      "format": "date",
      "description": "Fecha de ingreso a la empresa (yyyy-MM-dd)."
    },
    "fechaRetiro": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Fecha de retiro de la empresa (yyyy-MM-dd). Null si está activo."
    }
  }
}
