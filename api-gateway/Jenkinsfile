pipeline {
    agent { label 'docker' }

    parameters {
        string(name: 'BRANCH', defaultValue: 'main', description: 'Rama que se construirá')
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        SONAR_PROJECT_KEY = 'api-gateway'
        SONAR_QUALITY_GATE = 'RRHH-70'
        IMAGE = "system-hr/api-gateway:${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                // Las etapas siguientes ejecutan contenedores que escriben en el
                // workspace como root (coverage.xml, .pytest_cache, target/,
                // node_modules, coverage.out). Jenkins corre como el usuario
                // 'jenkins', de modo que el deleteDir() de la ejecucion
                // siguiente fallaba con AccessDeniedException: el primer build
                // de cada trabajo pasaba y el segundo ni arrancaba. Se vacia
                // antes con un contenedor root, usando el mismo mecanismo de
                // montaje que ya usan las demas etapas.
                script {
                    docker.image('alpine:3.22').inside('-u root') {
                        sh 'rm -rf ./* ./.[!.]* 2>/dev/null || true'
                    }
                }
                deleteDir()
                git branch: params.BRANCH, url: env.GIT_URL
            }
        }

        stage('Build') {
            steps {
                // Dentro de un contenedor de Maven, como las etapas de los
                // servicios Node y Python. El nodo de Jenkins trae JDK pero no
                // Maven, asi que estas tres etapas fallaban con
                // "mvn: not found" y los tres pipelines Java no pasaban de la
                // primera. El volumen hr-ci-m2 cachea las dependencias entre
                // ejecuciones, igual que hr-ci-npm en los de Node.
                script {
                    docker.image('maven:3.9-eclipse-temurin-21').inside('-u root -v hr-ci-m2:/root/.m2') {
                        dir('api-gateway') {
                            sh 'mvn -B clean compile -DskipTests'
                        }
                    }
                }
            }
        }

        stage('Test+JaCoCo') {
            steps {
                script {
                    docker.image('maven:3.9-eclipse-temurin-21').inside('-u root -v hr-ci-m2:/root/.m2') {
                        dir('api-gateway') {
                            // Basta 'verify': el jacoco-maven-plugin esta
                            // declarado en el pom con prepare-agent y report
                            // ligados al ciclo de vida. Invocando los goals
                            // desde la linea de comandos, el agente no se
                            // enganchaba a surefire, el informe se omitia
                            // ("missing execution data file") y la etapa
                            // fallaba al archivar un directorio inexistente.
                            sh 'mvn -B verify'
                        }
                    }
                }
            }
            post {
                always {
                    junit testResults: 'api-gateway/target/surefire-reports/TEST-*.xml',
                        allowEmptyResults: false
                    archiveArtifacts artifacts: 'api-gateway/target/site/jacoco/**',
                        allowEmptyArchive: false
                }
            }
        }

        stage('Sonar Scan') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        // --network: el contenedor tiene que resolver 'sonarqube'
                        // por DNS. Sin la red del CI el analisis fallaba con
                        // "Unknown host sonarqube". Es la misma red que usan los
                        // contenedores de sonar-scanner-cli de los otros pipelines.
                        docker.image('maven:3.9-eclipse-temurin-21').inside(
                            '-u root -v hr-ci-m2:/root/.m2 --network ' + (env.CI_NETWORK ?: 'system_hr_ci')
                        ) {
                            dir('api-gateway') {
                                // Coordenada completa del plugin, no el prefijo 'sonar':
                                // Maven solo resuelve prefijos de sus pluginGroups
                                // y org.sonarsource.scanner.maven no esta entre
                                // ellos. Fallaba con NoPluginFoundForPrefixException.
                                sh 'mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar -Dsonar.projectKey=$SONAR_PROJECT_KEY -Dsonar.qualitygate.wait=true'
                            }
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    echo "Validando Quality Gate ${env.SONAR_QUALITY_GATE}"
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker build') {
            steps {
                sh 'docker build --tag "$IMAGE" api-gateway'
            }
        }
    }
}
