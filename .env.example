# ── Puerto del API Gateway (único publicado al host) ─────────────────────────
# Cámbielo si el 8080 ya está ocupado en su máquina (por ejemplo, por Apache).
# Las colecciones de Postman usan la variable gatewayBaseUrl, así que basta con
# ajustarla allí para que apunten al mismo puerto.
GATEWAY_PORT=8080

# ── Reto 3: servicios existentes ─────────────────────────────────────────────
DEPARTAMENTOS_PORT=8081
DEPARTAMENTOS_DB_NAME=gestion_departamentos
DEPARTAMENTOS_DB_USER=postgres
DEPARTAMENTOS_DB_PASSWORD=postgres

EMPLEADOS_PORT=8080
EMPLEADOS_DB_NAME=gestion_empleados
EMPLEADOS_DB_USER=postgres
EMPLEADOS_DB_PASSWORD=postgres

DEPARTMENTS_SERVICE_URL=http://departments-service:8081

# ── Reto 4: nuevas bases de datos ─────────────────────────────────────────────
PERFILES_PORT=8083
PERFILES_DB_NAME=gestion_perfiles
PERFILES_DB_USER=postgres
PERFILES_DB_PASSWORD=postgres

NOTIFICACIONES_DB_NAME=gestion_notificaciones
NOTIFICACIONES_DB_USER=postgres
NOTIFICACIONES_DB_PASSWORD=postgres

VACACIONES_DB_NAME=gestion_vacaciones
VACACIONES_DB_USER=postgres
VACACIONES_DB_PASSWORD=postgres

# ── Reto 4: RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
# ── Reto 5: auth-service y su base de datos ───────────────────────────────────
AUTH_PORT=8085
AUTH_DB_NAME=gestion_auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres

# ── Secretos ──────────────────────────────────────────────────────────────────
# Ejecuta scripts/setup-secrets.sh para poblar
DB_PASSWORD=
JWT_SECRET=
JENKINS_ADMIN_PASSWORD=
SONAR_DB_PASSWORD=
SONAR_ADMIN_PASSWORD=
JWT_ISSUER=system-hr-auth
# Vigencia del Access JWT en segundos (1 hora).
JWT_ACCESS_TTL_SECONDS=3600
# Vigencia del token de activación/recuperación en segundos (1 hora).
JWT_RESET_TTL_SECONDS=3600

# ── Reto 5: administrador semilla ─────────────────────────────────────────────
# Necesario para arrancar: las cuentas de empleado se crean con rol USER desde
# el evento empleado.creado, así que sin esta cuenta nadie podría escribir.
AUTH_SEED_ADMIN_ID=admin
AUTH_SEED_ADMIN_EMAIL=admin@empresa.com
AUTH_SEED_ADMIN_PASSWORD=admin1234

# ── Reto 5: scheduler de vacaciones ───────────────────────────────────────────
# Expresión cron de 5 campos. Cada minuto durante el desarrollo, para poder
# demostrar el flujo de inicio y fin de vacaciones sin esperar días reales.
VACACIONES_CRON=* * * * *
VACACIONES_SCHEDULER_ENABLED=true

# Reto 7: ejecutar python3 ci/preparar-entorno.py para generar las contraseñas.
JENKINS_ADMIN_USER=admin
JENKINS_PORT=9091
JENKINS_URL=http://localhost:9091/
JENKINS_RESOURCE_URL=http://127.0.0.1:9091/
CI_NETWORK=system_hr_ci
CI_REPOSITORY_URL=https://github.com/MICROSERVICIOSUQ/System_HR.git
CI_REPOSITORY_BRANCH=valentina

# ── Reto 8: observabilidad ────────────────────────────────────────────────────
# Puertos de las interfaces del stack. Solo se publican al host para poder
# abrirlas en el navegador; el tráfico entre contenedores usa los nombres de red.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ZIPKIN_PORT=9411

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin1234

# Muestreo de trazas. 1.0 = 100%, correcto en desarrollo y QA porque se quiere
# visibilidad total. En producción iría entre 0.1 y 0.2 (head-based sampling),
# o tail-based en un OTel Collector para conservar el 100% de las trazas con
# error. Al ser variable de entorno se cambia sin reconstruir imágenes.
OTEL_TRACES_SAMPLER_ARG=1.0

# Canal de alertas. Un webhook de Discord es una CREDENCIAL: quien lo tenga
# puede publicar en el canal. Por eso vive aquí y no en el archivo de
# aprovisionamiento de Grafana, que sí se versiona; allí se referencia como
# ${DISCORD_WEBHOOK_URL}.
DISCORD_WEBHOOK_URL=

# Zona horaria de los contenedores que muestran horas a personas.
TZ=America/Bogota

# Dev 3: servidor de trazas incluido en el stack de main.
OTEL_EXPORTER_ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
