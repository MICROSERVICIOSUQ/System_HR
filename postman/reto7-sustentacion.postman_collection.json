  "item": [
    {
      "name": "0. Salud y seguridad",
      "item": [
        {
          "name": "0.1 Salud del gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Sin token no se leen empleados",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayBaseUrl}}/empleados"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
