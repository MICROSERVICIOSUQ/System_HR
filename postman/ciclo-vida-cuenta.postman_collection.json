    {
      "name": "1. Preparación",
      "item": [
        {
          "name": "1.1 Login ADMIN y fecha de hoy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "",
                  "// fechaInicio = fechaFin = hoy, la estrategia que sugiere el enunciado",
                  "// para poder demostrar el flujo con el scheduler corriendo cada minuto.",
                  "const hoy = new Date().toISOString().split('T')[0];",
                  "pm.collectionVariables.set('hoy', hoy);",
                  "console.log('Fecha usada para los períodos: ' + hoy);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{adminUsuario}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/login",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
