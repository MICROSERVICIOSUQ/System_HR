                  "",
                  "console.log('La cuenta pasa de SUSPENDIDA_TEMPORAL a DESACTIVADA_PERMANENTE.');",
                  "console.log('Esperado en auth-service: cuenta.desactivada con motivo RETIRO y permanente=true.');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayBaseUrl}}/empleados/{{bordeId}}",
