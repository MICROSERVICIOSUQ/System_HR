              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('pendResetToken');",
              "",
              "(() => {",
              "  let tries = 0;",
              "  function check() {",
              "    pm.sendRequest({url:pm.variables.get('gatewayBaseUrl')+'/auth/internal/tokens/restablecimiento',method:'POST',header:{Authorization:'Bearer '+pm.collectionVariables.get('pendAdminToken'),'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({empleadoId:pm.collectionVariables.get('pendEmpleadoId')})}}, (error, response) => {",
              "      let ready = false;",
              "      try { ready = !error && (response.code===200); } catch (_) {}",
              "      if (ready) {",
              "        pm.collectionVariables.set('pendResetToken',response.json().token);",
              "        pm.test(\"Auth ya permite emitir el token ADMIN\", () => pm.expect(ready).to.eql(true));",
              "        return;",
              "      }",
              "      if (++tries < 60) { setTimeout(check, 500); return; }",
              "      pm.test(\"Auth ya permite emitir el token ADMIN\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
              "    });",
              "  }",
              "  check();",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
