              "      if (++tries < 60) { setTimeout(check, 500); return; }",
              "      pm.test(\"El cambio de cuenta lleg\\u00f3 a Auth\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
              "    });",
              "  }",
              "  check();",
              "})();",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Forzar fin pendBorde",
      "request": {
        "method": "POST",
        "url": "{{gatewayBaseUrl}}/vacaciones/{{pendBordePeriodoId}}/forzar-fin",
        "header": []
      },
      "event": [
        {
          "listen": "test",
