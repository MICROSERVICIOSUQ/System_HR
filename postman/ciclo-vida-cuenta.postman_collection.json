        {
          "name": "1.4 Activar cuenta de E701 (automático)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pide el token de activacion a auth-service, que es quien lo firma.",
                  "//",
                  "// Antes se leia de GET /notificaciones, porque notifications-service guardaba el",
                  "// token en el payload de su historial. Eso era el hallazgo de seguridad que la",
                  "// auditoria pidio cerrar, y el servicio reconstruido en Go ya solo conserva",
                  "// campos publicos. Este es el canal legitimo, reservado al rol ADMIN.",
                  "const base  = pm.environment.get('gatewayBaseUrl') || pm.variables.get('gatewayBaseUrl');",
                  "const admin = pm.collectionVariables.get('adminToken');",
                  "const empleadoId = pm.collectionVariables.get('empleadoId');",
                  "",
                  "if (!admin) {",
                  "    console.log('Falta adminToken: ejecute antes el login del administrador.');",
                  "} else {",
                  "    pm.sendRequest({",
                  "        url: base + '/auth/internal/tokens/restablecimiento',",
                  "        method: 'POST',",
                  "        header: {",
                  "            'Authorization': 'Bearer ' + admin,",
                  "            'Content-Type': 'application/json',",
                  "            'Accept': 'application/json'",
                  "        },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ empleadoId: empleadoId }) }",
                  "    }, (err, res) => {",
                  "        if (err) { console.log('No se pudo pedir el token:', err); return; }",
                  "        if (res.code !== 200) {",
                  "            console.log('auth-service respondio ' + res.code + ': ' + res.text());",
                  "            return;",
                  "        }",
                  "        pm.collectionVariables.set('resetToken', res.json().token);",
                  "        console.log('resetToken emitido por auth-service para ' + empleadoId);",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('resetToken')) {",
                  "    pm.test('El script previo no pudo obtener el token', () => {",
                  "        pm.expect.fail('Revise la consola: ejecute antes 1.1 (login ADMIN) y 1.3 (crear E701)');",
                  "    });",
                  "} else {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "    console.log('Se publicó cuenta.activada con motivo ACTIVACION_INICIAL.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"nuevaPassword\": \"{{empleadoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/reset-password",
              "host": [
                "{{gatewayBaseUrl}}"
