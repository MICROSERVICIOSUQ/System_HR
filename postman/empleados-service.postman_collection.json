              "    // delegar, que es justo lo que la unificacion vino a eliminar.",
              "    const canonica = pm.collectionVariables.get('auditoriaCanonica');",
              "    pm.expect(pm.response.text()).to.eql(canonica);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "22. Auditoria del dia de hoy: un retiro de esta manana si aparece",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{gatewayBaseUrl}}/empleados?desde={{hoyUtc}}&hasta={{hoyUtc}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "empleados"
          ],
          "query": [
            {
              "key": "desde",
              "value": "{{hoyUtc}}"
            },
            {
              "key": "hasta",
              "value": "{{hoyUtc}}"
            }
          ]
        },
        "description": "Comprueba que el limite superior del rango cubre el dia completo."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// La fecha se calcula en UTC: los contenedores van en UTC y la maquina puede",
              "// ir en otra zona, asi que \"hoy\" puede diferir en varias horas.",
              "pm.collectionVariables.set('hoyUtc', new Date().toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "// Es el caso borde que el cambio a LocalDateTime hace facil romper: el retiro",
              "// ocurrio a una hora cualquiera de hoy, y si el limite superior se tomara como",
              "// la medianoche de 'hasta' en vez del final del dia, el empleado quedaria fuera",
              "// de su propio informe.",
              "pm.test('El rango de un solo dia incluye los retiros de ese dia', () => {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "",
              "console.log('Retirados hoy (' + pm.collectionVariables.get('hoyUtc') + '): '",
              "            + pm.response.json().length);"
            ]
          }
        }
      ]
    }
