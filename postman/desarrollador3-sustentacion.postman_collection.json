        {
          "name": "11 Programar vacaciones válidas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/vacaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empleadoId\": \"{{dev3EmpleadoId}}\",\n  \"fechaInicio\": \"{{dev3Inicio}}\",\n  \"fechaFin\": \"{{dev3Fin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code===201) pm.environment.set('dev3PeriodoId',pm.response.json().id);",
                  "let attempts = 0;",
                  "function checkHistory() {",
                  "  pm.sendRequest({url:pm.environment.get('dev3BaseUrl')+'/notifications/empleado/'+pm.environment.get('dev3EmpleadoId'),",
                  "    header:{Authorization:'Bearer '+pm.environment.get('dev3AdminToken')}},(error,response) => {",
                  "    const items = !error && response.code===200 ? response.json() : [];",
                  "    if (Array.isArray(items) && items.some(item=>item.eventType==='vacaciones.programadas')) {",
                  "      pm.test('Confirmación de vacaciones consumida',()=>pm.expect(items.some(item=>item.eventType==='vacaciones.programadas')).to.eql(true)); return;",
                  "    }",
                  "    if (++attempts<60) {setTimeout(checkHistory,200);return;}",
                  "    pm.test('Confirmación de vacaciones consumida',()=>{throw new Error('No llegó vacaciones.programadas');});",
                  "  });",
                  "}",
                  "checkHistory();"
                ]
              }
            }
          ]
        },
