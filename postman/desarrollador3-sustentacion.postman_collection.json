{
  "info": {
    "name": "Dev 3 - Sustentación Vacaciones y Notificaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Preparar primero una cuenta ACTIVA mediante el modo Postman del script de demo. Ejecutar en orden. Usa /notifications porque es la ruta actual del Gateway. Sin contraseñas incluidas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{dev3AdminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01. Acceso y datos preparados",
      "item": [
        {
          "name": "01 Login ADMIN y preparar fechas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{dev3AdminEmail}}\",\n  \"password\": \"{{dev3AdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for (const key of ['dev3AdminEmail','dev3AdminPassword','dev3EmpleadoId','dev3EmpleadoEmail','dev3EmpleadoPassword']) {",
                  "  if (!pm.environment.get(key)) throw new Error('Falta configurar ' + key + '. Consulte la guía.');",
                  "}",
                  "function fecha(offset) { const date = new Date(); date.setUTCDate(date.getUTCDate() + offset); return date.toISOString().slice(0,10); }",
                  "for (const [name,offset] of Object.entries({Inicio:5,Fin:7,Ayer:-1,NuevoInicio:8,NuevoFin:11,CancelInicio:15,CancelFin:18})) pm.environment.set('dev3'+name,fecha(offset));",
                  "pm.environment.unset('dev3PeriodoId'); pm.environment.unset('dev3CancelarId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('dev3AdminToken',pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Login del empleado ACTIVO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{dev3EmpleadoEmail}}\",\n  \"password\": \"{{dev3EmpleadoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('dev3UsuarioToken',pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Saldo y réplica del empleado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{dev3BaseUrl}}/vacaciones/balances/{{dev3EmpleadoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Bienvenida en historial sin tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{dev3BaseUrl}}/notifications/empleado/{{dev3EmpleadoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code===200) {",
                  " const items=pm.response.json();",
                  " pm.test('Historial sin campos token o password',()=>pm.expect(JSON.stringify(items)).not.to.match(/\"(?:token|password|nuevaPassword)\"\\s*:/i));",
                  " const welcome=items.find(item=>item.eventType==='usuario.creado');",
                  " if (welcome) pm.environment.set('dev3MessageId',welcome.messageId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Notificación por ID de evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{dev3BaseUrl}}/notifications/{{dev3MessageId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Consulta sin token rechazada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{dev3BaseUrl}}/vacaciones",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 USER no puede programar vacaciones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/vacaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empleadoId\": \"{{dev3EmpleadoId}}\",\n  \"fechaInicio\": \"{{dev3Inicio}}\",\n  \"fechaFin\": \"{{dev3Fin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{dev3UsuarioToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
