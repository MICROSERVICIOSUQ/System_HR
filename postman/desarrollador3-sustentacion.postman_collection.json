                  " pm.test('Historial sin campos token o password',()=>pm.expect(JSON.stringify(items)).not.to.match(/\"(?:token|password|nuevaPassword)\"\\s*:/i));",
                  " const welcome=items.find(item=>item.eventType==='usuario.creado');",
                  " if (welcome) pm.environment.set('dev3MessageId',welcome.messageId);",
                  "}"
                ]
