    {
      "name": "04. Cancelación y retiro al final",
      "item": [
        {
          "name": "21 Crear otro período para cancelar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/vacaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empleadoId\": \"{{dev3EmpleadoId}}\",\n  \"fechaInicio\": \"{{dev3CancelInicio}}\",\n  \"fechaFin\": \"{{dev3CancelFin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code===201) pm.environment.set('dev3CancelarId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "22 Cancelar período futuro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{dev3BaseUrl}}/vacaciones/{{dev3CancelarId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if(pm.response.code===200) pm.test('Conserva el historial como CANCELADA',()=>pm.expect(pm.response.json().data.estado).to.eql('CANCELADA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "23 Retirar empleado al terminar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{dev3BaseUrl}}/empleados/{{dev3EmpleadoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "let attempts = 0;",
                  "function checkLogin() {",
                  "  pm.sendRequest({ url: pm.environment.get('dev3BaseUrl')+'/auth/login', method:'POST', header:{'Content-Type':'application/json'},",
                  "    body:{mode:'raw',raw:JSON.stringify({usuario:pm.environment.get('dev3EmpleadoEmail'),password:pm.environment.get('dev3EmpleadoPassword')})}}, (error,response) => {",
                  "    if (!error && response.code === 401) { pm.test('Estado de cuenta aplicado por eventos', () => pm.expect(response.code).to.eql(401)); return; }",
                  "    if (++attempts < 60) { setTimeout(checkLogin,200); return; }",
                  "    pm.test('Estado de cuenta aplicado por eventos', () => { throw new Error('No llegó el estado esperado; revisar Auth y RabbitMQ'); });",
                  "  });",
                  "}",
                  "checkLogin();",
                  "",
                  "let balanceAttempts=0;",
                  "function checkRetirement() {",
                  " pm.sendRequest({url:pm.environment.get('dev3BaseUrl')+'/vacaciones/balances/'+pm.environment.get('dev3EmpleadoId'),header:{Authorization:'Bearer '+pm.environment.get('dev3AdminToken')}},(error,response)=>{",
                  "  if (!error && response.code===200 && response.json().estadoEmpleado==='RETIRADO') {",
                  "   pm.test('Retiro llegó a la réplica de Vacaciones',()=>pm.expect(response.json().estadoEmpleado).to.eql('RETIRADO'));return;",
                  "  }",
                  "  if (++balanceAttempts<60) {setTimeout(checkRetirement,200);return;}",
                  "  pm.test('Retiro llegó a la réplica de Vacaciones',()=>{throw new Error('No llegó el retiro a Vacaciones');});",
                  " });",
                  "}",
                  "checkRetirement();"
                ]
              }
            }
          ]
        },
        {
          "name": "24 Login rechazado tras el retiro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{dev3EmpleadoEmail}}\",\n  \"password\": \"{{dev3EmpleadoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "25 Vacaciones de empleado retirado rechazadas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{dev3BaseUrl}}/vacaciones",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"empleadoId\": \"{{dev3EmpleadoId}}\",\n  \"fechaInicio\": \"{{dev3CancelInicio}}\",\n  \"fechaFin\": \"{{dev3CancelFin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "26 Historial final sin credenciales",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{dev3BaseUrl}}/notifications/empleado/{{dev3EmpleadoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code===200) {",
                  " const items=pm.response.json();",
                  " pm.test('Historial sin campos token o password',()=>pm.expect(JSON.stringify(items)).not.to.match(/\"(?:token|password|nuevaPassword)\"\\s*:/i));",
                  " const welcome=items.find(item=>item.eventType==='usuario.creado');",
                  " if (welcome) pm.environment.set('dev3MessageId',welcome.messageId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
