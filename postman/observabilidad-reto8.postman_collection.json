              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "empleados"
              ]
            },
            "description": "Con departments-service caido, el alta de un empleado en un departamento NUNCA consultado antes responde 503: el circuit breaker del Reto 3 abre y el cache de contingencia no tiene entrada que servir. Si usara IT, el cache responderia y el alta funcionaria — que es justo el comportamiento resiliente que se diseno entonces, y que ahora ademas se VE en Zipkin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{empleadoDemoId}}-CAOS\",\n  \"nombre\": \"Caos\",\n  \"apellido\": \"Demo\",\n  \"email\": \"caos-{{empleadoDemoEmail}}\",\n  \"numeroEmpleado\": \"CAOS-{{empleadoDemoNumero}}\",\n  \"cargo\": \"Analista\",\n  \"area\": \"Tecnologia\",\n  \"departamentoId\": \"NUNCA-CONSULTADO\",\n  \"fechaIngreso\": \"2026-11-03\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
