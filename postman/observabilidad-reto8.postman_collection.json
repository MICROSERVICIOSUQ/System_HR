        {
          "name": "Logs de la traza",
          "request": {
            "method": "GET",
            "url": "{{lokiBaseUrl}}/loki/api/v1/query_range?query={job%3D%22docker%22}%20%7C%20json%20%7C%20traceId%20%3D%20%22{{pendTraceId}}%22&limit=100",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{lokiBaseUrl}}/loki/api/v1/query_range?query={job%3D%22docker%22}%20%7C%20json%20%7C%20traceId%20%3D%20%22{{pendTraceId}}%22&limit=100\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().data.result.flatMap(stream=>stream.values).length>0); } catch (_) {}",
                  "      if (ready) {",
                  "        ",
                  "const lines=response.json().data.result.flatMap(stream=>stream.values.map(value=>value[1]));",
                  "pm.test('Logs JSON con los campos del contrato',()=>{",
                  "  pm.expect(lines.length).to.be.greaterThan(0);",
                  "  const record=JSON.parse(lines[0]);",
                  "  for(const key of ['timestamp','level','service','traceId','message']) pm.expect(record).to.have.property(key);",
                  "});",
                  "pm.test('Varios servicios comparten la traza en sus logs',()=>{",
                  "  const services=new Set(lines.map(line=>{try{return JSON.parse(line).service;}catch(_){return undefined;}}).filter(Boolean));",
                  "  pm.expect(services.size).to.be.greaterThan(1);",
                  "});",
                  "",
                  "        pm.test(\"Hay logs de la traza\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"Hay logs de la traza\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
        },
