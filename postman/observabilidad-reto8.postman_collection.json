        {
          "name": "Reglas de alerta aprovisionadas",
          "request": {
            "method": "GET",
            "url": "{{grafanaBaseUrl}}/api/v1/provisioning/alert-rules",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
