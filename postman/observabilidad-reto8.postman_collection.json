                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{grafanaBaseUrl}}/api/alertmanager/grafana/api/v2/alerts\"),header:{Authorization:'Basic '+btoa(pm.variables.get('grafanaUser')+':'+pm.variables.get('grafanaPassword'))}}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().some(a=>a.labels?.job==='departments-service' || a.labels?.service==='departments-service')); } catch (_) {}",
                  "      if (ready) {",
