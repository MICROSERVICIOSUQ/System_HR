                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{zipkinBaseUrl}}/api/v2/trace/{{pendTraceId}}\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && [\"api-gateway\", \"employees-service\", \"departments-service\", \"auth-service\", \"profiles-service\", \"vacations-service\", \"notifications-service\"].every(s=>response.json().some(span=>span.localEndpoint?.serviceName===s))); } catch (_) {}",
                  "      if (ready) {",
                  "        ",
                  "        pm.test(\"Cadena distribuida completa en Zipkin\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"Cadena distribuida completa en Zipkin\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
