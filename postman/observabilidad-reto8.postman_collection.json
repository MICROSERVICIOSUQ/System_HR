        {
          "name": "Los siete servicios están UP",
          "request": {
            "method": "GET",
            "url": "{{prometheusBaseUrl}}/api/v1/query?query=up%7Bjob%21%3D%22prometheus%22%7D",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{prometheusBaseUrl}}/api/v1/query?query=up%7Bjob%21%3D%22prometheus%22%7D\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().data.result.length===7 && response.json().data.result.every(x=>Number(x.value[1])===1)); } catch (_) {}",
                  "      if (ready) {",
                  "        ",
                  "        pm.test(\"Siete objetivos de negocio disponibles\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"Siete objetivos de negocio disponibles\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Tráfico registrado en Prometheus",
          "request": {
            "method": "GET",
            "url": "{{prometheusBaseUrl}}/api/v1/query?query=sum%20by%20%28job%29%20%28rate%28http_server_requests_seconds_count%5B5m%5D%29%29%20or%20sum%20by%20%28job%29%20%28rate%28http_requests_total%5B5m%5D%29%29",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{prometheusBaseUrl}}/api/v1/query?query=sum%20by%20%28job%29%20%28rate%28http_server_requests_seconds_count%5B5m%5D%29%29%20or%20sum%20by%20%28job%29%20%28rate%28http_requests_total%5B5m%5D%29%29\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().data.result.length>0); } catch (_) {}",
                  "      if (ready) {",
                  "        ",
                  "        pm.test(\"Hay m\\u00e9tricas de tr\\u00e1fico\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"Hay m\\u00e9tricas de tr\\u00e1fico\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Latencia media del Gateway",
          "request": {
            "method": "GET",
            "url": "{{prometheusBaseUrl}}/api/v1/query?query=sum%28rate%28http_server_requests_seconds_sum%7Bjob%3D%22api-gateway%22%7D%5B5m%5D%29%29%20%2F%20sum%28rate%28http_server_requests_seconds_count%7Bjob%3D%22api-gateway%22%7D%5B5m%5D%29%29",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{prometheusBaseUrl}}/api/v1/query?query=sum%28rate%28http_server_requests_seconds_sum%7Bjob%3D%22api-gateway%22%7D%5B5m%5D%29%29%20%2F%20sum%28rate%28http_server_requests_seconds_count%7Bjob%3D%22api-gateway%22%7D%5B5m%5D%29%29\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().data.result.some(x=>Number.isFinite(Number(x.value[1])))); } catch (_) {}",
                  "      if (ready) {",
                  "        pm.test('Latencia media menor al umbral de alerta de 2 segundos',()=>{const result=response.json().data.result;pm.expect(result.length).to.be.greaterThan(0);pm.expect(Number(result[0].value[1])).to.be.below(2);});",
                  "        pm.test(\"Hay muestras de latencia\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"Hay muestras de latencia\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "La traza de onboarding contiene los siete servicios",
          "request": {
            "method": "GET",
            "url": "{{zipkinBaseUrl}}/api/v2/trace/{{pendTraceId}}",
            "header": [],
