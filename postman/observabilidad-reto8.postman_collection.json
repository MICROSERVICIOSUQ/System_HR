    {
      "name": "02 Caida controlada",
      "item": [
        {
          "name": "Prometheus detecta Departamentos caído",
          "request": {
            "method": "GET",
            "url": "{{prometheusBaseUrl}}/api/v1/query?query=up%7Bjob%3D%22departments-service%22%7D",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "",
                  "(() => {",
                  "  let tries = 0;",
                  "  function check() {",
                  "    pm.sendRequest({url:pm.variables.replaceIn(\"{{prometheusBaseUrl}}/api/v1/query?query=up%7Bjob%3D%22departments-service%22%7D\")}, (error, response) => {",
                  "      let ready = false;",
                  "      try { ready = !error && (response.code===200 && response.json().data.result.some(x=>Number(x.value[1])===0)); } catch (_) {}",
                  "      if (ready) {",
                  "        ",
                  "        pm.test(\"up=0 observado\", () => pm.expect(ready).to.eql(true));",
                  "        return;",
                  "      }",
                  "      if (++tries < 120) { setTimeout(check, 500); return; }",
                  "      pm.test(\"up=0 observado\", () => { throw new Error('No se alcanzó la condición esperada dentro del tiempo de espera'); });",
                  "    });",
                  "  }",
                  "  check();",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Grafana muestra su alerta activa",
          "request": {
            "method": "GET",
            "url": "{{grafanaBaseUrl}}/api/alertmanager/grafana/api/v2/alerts",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{grafanaUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{grafanaPassword}}",
                  "type": "string"
                }
              ]
