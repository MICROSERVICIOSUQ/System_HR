      "key": "empleadoEmail",
      "value": "laura.mendez@empresa.com",
      "type": "string"
    },
    {
      "key": "numeroEmpleado",
      "value": "EMP-2026-501",
      "description": "Numero de empleado, unico en employees-service. Estaba fijo en el cuerpo del request 3; como variable se puede cambiar para repetir la coleccion sin vaciar la base de datos."
    },
