  ],
  "item": [
    {
      "name": "1. Login del administrador semilla",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const b = pm.response.json();",
              "",
              "pm.test('Devuelve un Bearer con rol ADMIN', () => {",
              "    pm.expect(b.tipo).to.eql('Bearer');",
              "    pm.expect(b.rol).to.eql('ADMIN');",
              "    pm.expect(b.expiraEnSegundos).to.be.a('number');",
              "});",
              "",
              "pm.test('El JWT tiene tres segmentos y los claims del enunciado', () => {",
              "    const partes = b.token.split('.');",
              "    pm.expect(partes).to.have.lengthOf(3);",
              "    const payload = JSON.parse(atob(partes[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "    pm.expect(payload.sub).to.eql(b.empleadoId);",
              "    pm.expect(payload.role).to.eql('ADMIN');",
              "    pm.expect(payload).to.have.property('iat');",
              "    pm.expect(payload).to.have.property('exp');",
              "});",
              "",
              "pm.test('El token no contiene la contraseña', () => {",
              "    const payload = atob(b.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'));",
              "    pm.expect(payload.toLowerCase()).to.not.include('password');",
              "});",
              "",
              "pm.collectionVariables.set('adminToken', b.token);",
              "",
              "// ── Datos unicos por ejecucion ──────────────────────────────────────────────",
              "//",
              "// La coleccion usaba E501 / laura.mendez@empresa.com / EMP-2026-501 fijos, de",
              "// modo que la segunda vez que se ejecutaba sobre la misma base el POST",
              "// /empleados respondia 400 por duplicado y arrastraba al resto: sin empleado no",
              "// hay cuenta, y sin cuenta no hay token ni login. Se generan aqui, en el primer",
              "// request, para que toda la ejecucion comparta los mismos valores.",
              "const sufijo = String(Date.now()).slice(-9);",
              "pm.collectionVariables.set('empleadoId', 'E5' + sufijo.slice(-4));",
              "pm.collectionVariables.set('empleadoEmail', 'laura.mendez.' + sufijo + '@empresa.com');",
              "pm.collectionVariables.set('numeroEmpleado', 'EMP-' + sufijo);",
              "console.log('Datos de esta ejecucion: ' + pm.collectionVariables.get('empleadoId')",
              "            + ' / ' + pm.collectionVariables.get('empleadoEmail'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{adminUsuario}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/auth/login",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Endpoint público. El administrador semilla se crea al arrancar el servicio desde AUTH_SEED_ADMIN_*; sin él no habría forma de ejecutar ninguna operación de escritura."
      },
      "response": []
    },
