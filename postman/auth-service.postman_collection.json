            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));",
              "",
              "// El mensaje es generico a proposito. La cuenta existe desde el request 3 pero",
              "// todavia no tiene contrasena, y auth-service verifica las credenciales ANTES de",
              "// mirar el estado de la cuenta. Responder aqui 'la cuenta no esta activada' le",
              "// revelaria a un desconocido que ese correo esta registrado en la empresa.",
              "pm.test('No revela el estado de la cuenta antes de verificar credenciales', () => {",
              "    pm.expect(pm.response.json().message).to.eql('Credenciales inválidas');",
              "});"
            ]
