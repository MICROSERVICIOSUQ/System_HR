        {
          "name": "5.2 DELETE /empleados/E602 con token ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 o 204', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});",
                  "",
                  "console.log('Se publicó empleado.retirado: el auth-service debe desactivar la cuenta de E602 de forma permanente.');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
