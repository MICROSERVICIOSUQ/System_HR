            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"IT\",\n  \"nombre\": \"Tecnología\",\n  \"descripcion\": \"Departamento de tecnología\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/departamentos",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["departamentos"]
