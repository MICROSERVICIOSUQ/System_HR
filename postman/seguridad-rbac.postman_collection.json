            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{propioId}}\",\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"Ruiz\",\n  \"email\": \"{{propioEmail}}\",\n  \"numeroEmpleado\": \"EMP-2026-601\",\n  \"cargo\": \"Analista\",\n  \"area\": \"Tecnología\",\n  \"departamentoId\": \"IT\",\n  \"fechaIngreso\": \"2026-05-01\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
