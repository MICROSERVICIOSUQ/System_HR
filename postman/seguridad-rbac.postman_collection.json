    {
      "name": "2. Activación y login del rol USER",
      "item": [
        {
          "name": "2.1 Establecer contraseña de E601",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('resetToken')) {",
                  "    pm.test('SALTADO: falta pegar resetToken', () => {",
                  "        pm.expect.fail('Copie el token de activación del log de notificaciones a la variable resetToken');",
                  "    });",
                  "} else {",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"nuevaPassword\": \"{{propioPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayBaseUrl}}/auth/reset-password",
              "host": ["{{gatewayBaseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          },
          "response": []
        },
        {
          "name": "2.2 Login de E601 (rol USER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test('Rol USER y sub = E601', () => {",
                  "    pm.expect(b.rol).to.eql('USER');",
                  "    pm.expect(b.empleadoId).to.eql(pm.collectionVariables.get('propioId'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('userToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{propioEmail}}\",\n  \"password\": \"{{propioPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
